# Maintainer: jxoesneon <jxoesneon@users.noreply.github.com>
pkgname=ultranix-mcp-bin
_pkgname=ultranix-mcp
pkgver=1.4.0
pkgrel=1
pkgdesc="Wayland-native, security-first MCP server for Linux desktop automation (Hyprland-first, with sway/KDE fallbacks and clipboard tools) - prebuilt binary"
arch=('x86_64')
url="https://github.com/jxoesneon/ultranix-mcp"
license=('ISC')
depends=(
  'libxkbcommon'      # virtual-keyboard keymap handling
  'dbus'              # zbus / portals / AT-SPI2 session bus
  'libpipewire'       # portal RemoteDesktop stream consumer (linked libpipewire-0.3)
  'gcc-libs'          # statically-linked ONNX Runtime pulls libstdc++/libgcc_s
)
optdepends=(
  'xdg-desktop-portal-hyprland: screen-capture consent path on Hyprland'
  'xdg-desktop-portal-wlr: portal backend for other wlroots compositors'
  'xdg-desktop-portal-gnome: portal backend under GNOME'
  'pipewire: PipeWire daemon for the portal RemoteDesktop capture stream (v1.1.0+ consumes the video fd when Screenshot is not advertised)'
  'wl-clipboard: Wayland clipboard tools (wl-copy/wl-paste) used by the clipboard backend'
  'at-spi2-core: semantic UI tree (a11y backend)'
  'grim: whitelisted system_command capture helper (wlroots)'
  'slurp: whitelisted system_command region-picker (wlroots)'
  'xdotool: X11 input fallback + pointer position (X11 sessions only)'
  'scrot: X11 capture fallback (X11 sessions only)'
  'wmctrl: X11 window-management fallback (X11 sessions only)'
  'xclip: X11 clipboard tool used by the clipboard backend'
  'xsel: X11 clipboard clear helper used by the clipboard backend'
  'kdotool: KDE KWin window-management helper'
  'river: riverctl for the river window rung (focused-view window_control only - no list IPC) - v1.4.0+'
  'xorg-xrandr: X11 output-geometry enrichment for the capture backend (X11 sessions only)'
  'xorg-xprop: X11 _NET_WM_STATE enrichment for the window backend (X11 sessions only)'
)
provides=('ultranix-mcp')
conflicts=('ultranix-mcp' 'ultranix-mcp-git')
install=ultranix-mcp-bin.install
# Prebuilt release tarball attached to the GitHub release by
# .github/workflows/release.yml (x86_64-unknown-linux-gnu only - there is
# no aarch64 release asset yet, hence the single-arch source).
source_x86_64=("${_pkgname}-${pkgver}-x86_64-unknown-linux-gnu.tar.gz::${url}/releases/download/v${pkgver}/${_pkgname}-${pkgver}-x86_64-unknown-linux-gnu.tar.gz")
# Regenerate with `updpkgsums` after the v1.4.0 release asset lands -
# the archive hash cannot exist before the release does. SKIP is
# intentional until then.
sha256sums_x86_64=('SKIP')

package() {
  cd "${_pkgname}-${pkgver}-x86_64-unknown-linux-gnu"
  install -Dm0755 "ultranix-mcp" \
    "${pkgdir}/usr/bin/ultranix-mcp"
  install -Dm0644 LICENSE \
    "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
  install -Dm0644 "ultranix-mcp.service" \
    "${pkgdir}/usr/lib/systemd/user/ultranix-mcp.service"
  install -Dm0644 "99-ultranix-mcp-uinput.rules" \
    "${pkgdir}/usr/lib/udev/rules.d/99-ultranix-mcp-uinput.rules"
  install -Dm0644 "README-uinput.md" \
    "${pkgdir}/usr/share/doc/${pkgname}/README-uinput.md"
  install -Dm0644 README.md \
    "${pkgdir}/usr/share/doc/${pkgname}/README.md"
}
